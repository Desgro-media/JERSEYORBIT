# Copy to .env and adjust. Never commit .env: this repository is public.

# The value below matches docker-compose.yml. For a hosted database, use the address your host gives you
# (usually ending in ?sslmode=require).
DATABASE_URL=postgres://jerseyorbit:jerseyorbit_local@127.0.0.1:5438/jerseyorbit

# Optional, but recommended on a live server: run "npm run db:app-role", put the connection it prints in
# DATABASE_URL, and put the owner connection (the one you started with) here. The website then cannot
# change the database structure, create admins or edit the activity log. Migrations, db:seed and
# admin:create use this connection.
# DATABASE_OWNER_URL=

PORT=4000
HOST=127.0.0.1

# "development" is for your own computer only. Anything else, including nothing at all, runs in live
# mode: the sign-in cookie only works over HTTPS, and the local database password above is refused.
# On a live server set NODE_ENV=production and HOST=0.0.0.0.
NODE_ENV=development

# The addresses of the proxy in front of the app, so that rate limits see each visitor's real IP.
# Leave empty when nothing sits in front. For a proxy on the same machine or private network (nginx,
# and many hosts) use:  loopback,uniquelocal
# You can also list ranges such as 100.64.0.0/10. Numbers and "true" are refused.
# If the setting is missing or wrong, the server logs "untrusted proxy" with the address to add.
TRUST_PROXY=

# Where uploaded product photos are saved. On a live server this must be a persistent disk.
# It must be a folder just for photos, not one that contains the app.
# UPLOAD_DIR=./uploads
